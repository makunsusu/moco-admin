<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moco.system.mapper.ShHomeMapper">

    <resultMap type="ShHome" id="ShHomeResult">
        <id property="homeId" column="home_id"/>
        <result property="platformCode" column="platform_code"/>
        <result property="cloudHomeId" column="cloud_home_id"/>
        <result property="homeName" column="home_name"/>
        <result property="region" column="region"/>
        <result property="roomCount" column="room_count"/>
        <result property="deviceCount" column="device_count"/>
        <result property="status" column="status"/>
        <result property="lastSyncTime" column="last_sync_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectHomeVo">
        select home_id, platform_code, cloud_home_id, home_name, region, room_count, device_count, status,
               last_sync_time, create_by, create_time, update_by, update_time, remark
        from sh_home
    </sql>

    <select id="selectHomeList" parameterType="ShHome" resultMap="ShHomeResult">
        <include refid="selectHomeVo"/>
        <where>
            <if test="homeName != null and homeName != ''">
                and home_name like concat('%', #{homeName}, '%')
            </if>
            <if test="region != null and region != ''">
                and region = #{region}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by home_id desc
    </select>

    <select id="selectHomeByCloudHomeId" parameterType="String" resultMap="ShHomeResult">
        <include refid="selectHomeVo"/>
        where cloud_home_id = #{cloudHomeId}
        limit 1
    </select>

    <insert id="insertHome" parameterType="ShHome" useGeneratedKeys="true" keyProperty="homeId">
        insert into sh_home(
            platform_code, cloud_home_id, home_name, region, room_count, device_count, status,
            last_sync_time, create_by, create_time, remark
        ) values (
            #{platformCode}, #{cloudHomeId}, #{homeName}, #{region}, #{roomCount}, #{deviceCount}, #{status},
            #{lastSyncTime}, #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateHome" parameterType="ShHome">
        update sh_home
        <set>
            <if test="platformCode != null and platformCode != ''">platform_code = #{platformCode},</if>
            <if test="homeName != null and homeName != ''">home_name = #{homeName},</if>
            <if test="region != null">region = #{region},</if>
            <if test="roomCount != null">room_count = #{roomCount},</if>
            <if test="deviceCount != null">device_count = #{deviceCount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="lastSyncTime != null">last_sync_time = #{lastSyncTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where home_id = #{homeId}
    </update>

    <delete id="deleteAllHomes">
        delete from sh_home
    </delete>

</mapper>
