<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moco.system.mapper.ShRoomMapper">

    <resultMap type="ShRoom" id="ShRoomResult">
        <id property="roomId" column="room_id"/>
        <result property="homeId" column="home_id"/>
        <result property="homeName" column="home_name"/>
        <result property="cloudRoomId" column="cloud_room_id"/>
        <result property="roomName" column="room_name"/>
        <result property="deviceCount" column="device_count"/>
        <result property="status" column="status"/>
        <result property="lastSyncTime" column="last_sync_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectRoomVo">
        select room_id, home_id, home_name, cloud_room_id, room_name, device_count, status,
               last_sync_time, create_by, create_time, update_by, update_time, remark
        from sh_room
    </sql>

    <select id="selectRoomList" parameterType="ShRoom" resultMap="ShRoomResult">
        <include refid="selectRoomVo"/>
        <where>
            <if test="homeId != null">
                and home_id = #{homeId}
            </if>
            <if test="homeName != null and homeName != ''">
                and home_name like concat('%', #{homeName}, '%')
            </if>
            <if test="roomName != null and roomName != ''">
                and room_name like concat('%', #{roomName}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by room_id desc
    </select>

    <select id="selectRoomByCloudRoomId" parameterType="String" resultMap="ShRoomResult">
        <include refid="selectRoomVo"/>
        where cloud_room_id = #{cloudRoomId}
        limit 1
    </select>

    <insert id="insertRoom" parameterType="ShRoom" useGeneratedKeys="true" keyProperty="roomId">
        insert into sh_room(
            home_id, home_name, cloud_room_id, room_name, device_count, status, last_sync_time,
            create_by, create_time, remark
        ) values (
            #{homeId}, #{homeName}, #{cloudRoomId}, #{roomName}, #{deviceCount}, #{status}, #{lastSyncTime},
            #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateRoom" parameterType="ShRoom">
        update sh_room
        <set>
            <if test="homeId != null">home_id = #{homeId},</if>
            <if test="homeName != null">home_name = #{homeName},</if>
            <if test="roomName != null and roomName != ''">room_name = #{roomName},</if>
            <if test="deviceCount != null">device_count = #{deviceCount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="lastSyncTime != null">last_sync_time = #{lastSyncTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where room_id = #{roomId}
    </update>

    <delete id="deleteAllRooms">
        delete from sh_room
    </delete>

</mapper>
